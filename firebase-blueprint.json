{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Private Google-verified player identity profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Player Google display name",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google email address",
          "maxLength": 200
        },
        "photoURL": {
          "type": "string",
          "description": "Google profile avatar URL",
          "maxLength": 500
        },
        "nickname": {
          "type": "string",
          "description": "In-game player nickname chosen during Spider Spikey account creation",
          "maxLength": 24
        },
        "spiderColor": {
          "type": "string",
          "enum": ["classic", "emerald", "cobalt", "amethyst", "crimson"],
          "description": "Selected Spikey starter fur tint"
        },
        "profileCompleted": {
          "type": "boolean",
          "description": "Whether the player completed in-game account creation"
        },
        "lastVerifiedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest Gmail 6-digit OTP verification"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created"
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest Google login"
        }
      },
      "required": ["uid", "email", "nickname", "spiderColor", "profileCompleted", "createdAt", "lastLoginAt"]
    },
    "UserSave": {
      "title": "User Game Save",
      "description": "Per-account Spider Spikey progression, crystals, abilities, and campaign achievements",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Owner Firebase Auth UID",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hasStarted": {
          "type": "boolean",
          "description": "Whether player has launched a stage"
        },
        "currentStageId": {
          "type": "string",
          "description": "Most recent active stage ID",
          "maxLength": 24,
          "pattern": "^[0-9]+-(1|2|Boss)$"
        },
        "unlockedStageIds": {
          "type": "array",
          "description": "List of unlocked stage IDs (max 20)"
        },
        "unlockedAbilities": {
          "type": "object",
          "description": "Map of 7 ability unlock booleans"
        },
        "activeSpecial": {
          "type": "string",
          "enum": ["webTrap", "magicWeb"],
          "description": "Currently selected special ability"
        },
        "totalCoins": {
          "type": "integer",
          "description": "Total golden coins earned (synced with Spikey Coins)"
        },
        "totalScore": {
          "type": "integer",
          "description": "Cumulative campaign score"
        },
        "lives": {
          "type": "integer",
          "description": "Remaining Spikey lives"
        },
        "stageProgress": {
          "type": "object",
          "description": "Per-stage completion, crystals, bestScore, and bestTimeSec"
        },
        "unlockedAchievements": {
          "type": "array",
          "description": "List of unlocked achievement IDs"
        },
        "bossesDefeated": {
          "type": "array",
          "description": "List of defeated boss identifiers"
        },
        "enemiesDefeatedTotal": {
          "type": "integer",
          "description": "Total enemies defeated"
        },
        "secretsFoundTotal": {
          "type": "integer",
          "description": "Total hidden secrets discovered"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-save timestamp"
        }
      },
      "required": [
        "ownerId",
        "hasStarted",
        "currentStageId",
        "unlockedStageIds",
        "unlockedAbilities",
        "activeSpecial",
        "totalCoins",
        "totalScore",
        "lives",
        "stageProgress",
        "unlockedAchievements",
        "bossesDefeated",
        "enemiesDefeatedTotal",
        "secretsFoundTotal",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserEconomy": {
      "title": "User Economy & Season Progression",
      "description": "Owner-only Spikey Coins wallet, skin inventory, cases, 50-level Season Pass, 30-day login streak, missions, holiday rewards, and transaction ledger",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "spikeyCoins": {
          "type": "integer",
          "description": "Unified persistent Spikey Coins balance"
        },
        "equippedSkin": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownedSkins": {
          "type": "object",
          "description": "Map of skinId to quantity owned"
        },
        "equippedWebDesign": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Currently equipped Spider Web design ID"
        },
        "ownedWebDesigns": {
          "type": "object",
          "description": "Map of webDesignId to quantity owned"
        },
        "playerXp": {
          "type": "integer",
          "description": "Cumulative player XP for levels 1..100"
        },
        "playerLevel": {
          "type": "integer",
          "description": "Player progression level (1..100)"
        },
        "selectedLanguage": {
          "type": "string",
          "maxLength": 12,
          "description": "Preferred UI language code"
        },
        "ownedCases": {
          "type": "object",
          "description": "Map of caseType to quantity owned"
        },
        "specialItems": {
          "type": "object",
          "description": "Map of special/seasonal item IDs to quantity owned"
        },
        "seasonMonthKey": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "seasonXp": {
          "type": "integer"
        },
        "claimedSeasonLevels": {
          "type": "array"
        },
        "dailyStreak": {
          "type": "integer"
        },
        "claimedDailyDays": {
          "type": "array"
        },
        "lastDailyClaimDate": {
          "type": "string",
          "maxLength": 12
        },
        "dailyMissionDate": {
          "type": "string",
          "maxLength": 12
        },
        "weeklyMissionKey": {
          "type": "string",
          "maxLength": 12
        },
        "missionProgress": {
          "type": "object"
        },
        "claimedMissions": {
          "type": "array"
        },
        "holidayClaimedIds": {
          "type": "array"
        },
        "casesOpenedTotal": {
          "type": "integer"
        },
        "mythicsFoundTotal": {
          "type": "integer"
        },
        "skinsSoldTotal": {
          "type": "integer"
        },
        "tradesCompletedTotal": {
          "type": "integer"
        },
        "unlockedEconomyAchievements": {
          "type": "array"
        },
        "transactions": {
          "type": "array"
        },
        "processedTxIds": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "spikeyCoins",
        "equippedSkin",
        "ownedSkins",
        "ownedCases",
        "specialItems",
        "seasonMonthKey",
        "seasonXp",
        "claimedSeasonLevels",
        "dailyStreak",
        "claimedDailyDays",
        "lastDailyClaimDate",
        "dailyMissionDate",
        "weeklyMissionKey",
        "missionProgress",
        "claimedMissions",
        "holidayClaimedIds",
        "casesOpenedTotal",
        "mythicsFoundTotal",
        "skinsSoldTotal",
        "tradesCompletedTotal",
        "unlockedEconomyAchievements",
        "transactions",
        "processedTxIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeaderboardEntry": {
      "title": "Public Leaderboard Entry",
      "description": "Strictly non-PII public leaderboard and trade partner directory record",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isPublic": {
          "type": "boolean"
        },
        "nickname": {
          "type": "string",
          "maxLength": 24
        },
        "equippedSkin": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "seasonLevel": {
          "type": "integer"
        },
        "playerLevel": {
          "type": "integer",
          "description": "Player progression level (1..100)"
        },
        "seasonMonthKey": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "totalCoins": {
          "type": "integer"
        },
        "skinsCount": {
          "type": "integer"
        },
        "bossesDefeatedCount": {
          "type": "integer"
        },
        "achievementsCount": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "isPublic",
        "nickname",
        "equippedSkin",
        "seasonLevel",
        "seasonMonthKey",
        "totalCoins",
        "skinsCount",
        "bossesDefeatedCount",
        "achievementsCount",
        "updatedAt"
      ]
    },
    "TradeOffer": {
      "title": "Player Skin Trade Offer",
      "description": "Verified two-player Firestore skin exchange offer with dual confirmation",
      "type": "object",
      "properties": {
        "tradeId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderNickname": {
          "type": "string",
          "maxLength": 24
        },
        "recipientUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientNickname": {
          "type": "string",
          "maxLength": 24
        },
        "offeredSkinId": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "requestedSkinId": {
          "type": "string",
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderConfirmed": {
          "type": "boolean"
        },
        "recipientConfirmed": {
          "type": "boolean"
        },
        "senderSettled": {
          "type": "boolean"
        },
        "recipientSettled": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "rejected", "cancelled", "completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "tradeId",
        "senderUid",
        "senderNickname",
        "recipientUid",
        "recipientNickname",
        "offeredSkinId",
        "requestedSkinId",
        "senderConfirmed",
        "recipientConfirmed",
        "senderSettled",
        "recipientSettled",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private Google-authenticated player profile keyed by UID"
    },
    "/userSaves/{userId}": {
      "schema": { "$ref": "#/entities/UserSave" },
      "description": "Owner-only Spider Spikey cloud save document keyed by UID"
    },
    "/userEconomy/{userId}": {
      "schema": { "$ref": "#/entities/UserEconomy" },
      "description": "Owner-only Spikey Coins, inventory, cases, Season Pass, login streak, and ledger keyed by UID"
    },
    "/leaderboard/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "Public non-PII global leaderboard stats readable by verified players"
    },
    "/trades/{tradeId}": {
      "schema": { "$ref": "#/entities/TradeOffer" },
      "description": "Two-player verified skin trading offers"
    }
  }
}
