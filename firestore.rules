rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidSpiderColor(c) {
      return c is string && (c == 'classic' || c == 'emerald' || c == 'cobalt' || c == 'amethyst' || c == 'crimson');
    }

    function isValidSkinId(id) {
      return id is string && id.size() >= 1 && id.size() <= 48 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMonthKey(k) {
      return k is string && k.size() >= 7 && k.size() <= 10 && k.matches('^[0-9]{4}-[0-9]{2}$');
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'nickname',
          'spiderColor',
          'profileCompleted',
          'createdAt',
          'lastLoginAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'nickname',
          'spiderColor',
          'profileCompleted',
          'lastVerifiedAt',
          'createdAt',
          'lastLoginAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.nickname is string
        && data.nickname.size() <= 24
        && isValidSpiderColor(data.spiderColor)
        && data.profileCompleted is bool
        && (!('lastVerifiedAt' in data) || data.lastVerifiedAt is timestamp)
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function isValidAbilitiesMap(ab) {
      return ab is map
        && ab.keys().hasAll(['webShot', 'doubleJump', 'webTrap', 'wallClimb', 'webSwing', 'spiderDash', 'magicWeb'])
        && ab.keys().hasOnly(['webShot', 'doubleJump', 'webTrap', 'wallClimb', 'webSwing', 'spiderDash', 'magicWeb'])
        && ab.webShot is bool
        && ab.doubleJump is bool
        && ab.webTrap is bool
        && ab.wallClimb is bool
        && ab.webSwing is bool
        && ab.spiderDash is bool
        && ab.magicWeb is bool;
    }

    function isValidUserSave(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'hasStarted',
          'currentStageId',
          'unlockedStageIds',
          'unlockedAbilities',
          'activeSpecial',
          'totalCoins',
          'totalScore',
          'lives',
          'stageProgress',
          'unlockedAchievements',
          'bossesDefeated',
          'enemiesDefeatedTotal',
          'secretsFoundTotal',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'hasStarted',
          'currentStageId',
          'unlockedStageIds',
          'unlockedAbilities',
          'activeSpecial',
          'totalCoins',
          'totalScore',
          'lives',
          'stageProgress',
          'unlockedAchievements',
          'bossesDefeated',
          'enemiesDefeatedTotal',
          'secretsFoundTotal',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.hasStarted is bool
        && data.currentStageId is string
        && data.currentStageId.size() >= 3
        && data.currentStageId.size() <= 24
        && data.currentStageId.matches('^[0-9]+-(1|2|Boss)$')
        && data.unlockedStageIds is list
        && data.unlockedStageIds.size() >= 1
        && data.unlockedStageIds.size() <= 20
        && data.unlockedStageIds[0] is string
        && isValidAbilitiesMap(data.unlockedAbilities)
        && data.activeSpecial is string
        && data.activeSpecial.size() <= 16
        && (data.activeSpecial == 'webTrap' || data.activeSpecial == 'magicWeb')
        && data.totalCoins is int
        && data.totalCoins >= 0
        && data.totalCoins <= 50000000
        && data.totalScore is int
        && data.totalScore >= 0
        && data.totalScore <= 100000000
        && data.lives is int
        && data.lives >= 0
        && data.lives <= 99
        && data.stageProgress is map
        && data.stageProgress.size() <= 20
        && data.unlockedAchievements is list
        && data.unlockedAchievements.size() <= 50
        && (data.unlockedAchievements.size() == 0 || data.unlockedAchievements[0] is string)
        && data.bossesDefeated is list
        && data.bossesDefeated.size() <= 10
        && (data.bossesDefeated.size() == 0 || data.bossesDefeated[0] is string)
        && data.enemiesDefeatedTotal is int
        && data.enemiesDefeatedTotal >= 0
        && data.enemiesDefeatedTotal <= 10000000
        && data.secretsFoundTotal is int
        && data.secretsFoundTotal >= 0
        && data.secretsFoundTotal <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserEconomy(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'spikeyCoins',
          'equippedSkin',
          'ownedSkins',
          'ownedCases',
          'specialItems',
          'seasonMonthKey',
          'seasonXp',
          'claimedSeasonLevels',
          'dailyStreak',
          'claimedDailyDays',
          'lastDailyClaimDate',
          'dailyMissionDate',
          'weeklyMissionKey',
          'missionProgress',
          'claimedMissions',
          'holidayClaimedIds',
          'casesOpenedTotal',
          'mythicsFoundTotal',
          'skinsSoldTotal',
          'tradesCompletedTotal',
          'unlockedEconomyAchievements',
          'transactions',
          'processedTxIds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'spikeyCoins',
          'equippedSkin',
          'ownedSkins',
          'equippedWebDesign',
          'ownedWebDesigns',
          'playerXp',
          'playerLevel',
          'selectedLanguage',
          'ownedCases',
          'specialItems',
          'seasonMonthKey',
          'seasonXp',
          'claimedSeasonLevels',
          'dailyStreak',
          'claimedDailyDays',
          'lastDailyClaimDate',
          'dailyMissionDate',
          'weeklyMissionKey',
          'missionProgress',
          'claimedMissions',
          'holidayClaimedIds',
          'casesOpenedTotal',
          'mythicsFoundTotal',
          'skinsSoldTotal',
          'tradesCompletedTotal',
          'unlockedEconomyAchievements',
          'transactions',
          'processedTxIds',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.spikeyCoins is int
        && data.spikeyCoins >= 0
        && data.spikeyCoins <= 50000000
        && isValidSkinId(data.equippedSkin)
        && data.ownedSkins is map
        && data.ownedSkins.size() <= 140
        && (!('equippedWebDesign' in data) || isValidSkinId(data.equippedWebDesign))
        && (!('ownedWebDesigns' in data) || (data.ownedWebDesigns is map && data.ownedWebDesigns.size() <= 60))
        && (!('playerXp' in data) || (data.playerXp is int && data.playerXp >= 0 && data.playerXp <= 10000000))
        && (!('playerLevel' in data) || (data.playerLevel is int && data.playerLevel >= 1 && data.playerLevel <= 100))
        && (!('selectedLanguage' in data) || (data.selectedLanguage is string && data.selectedLanguage.size() >= 2 && data.selectedLanguage.size() <= 12))
        && data.ownedCases is map
        && data.ownedCases.size() <= 20
        && data.specialItems is map
        && data.specialItems.size() <= 30
        && isValidMonthKey(data.seasonMonthKey)
        && data.seasonXp is int
        && data.seasonXp >= 0
        && data.seasonXp <= 1000000
        && data.claimedSeasonLevels is list
        && data.claimedSeasonLevels.size() <= 50
        && (data.claimedSeasonLevels.size() == 0 || data.claimedSeasonLevels[0] is int)
        && data.dailyStreak is int
        && data.dailyStreak >= 0
        && data.dailyStreak <= 30
        && data.claimedDailyDays is list
        && data.claimedDailyDays.size() <= 30
        && (data.claimedDailyDays.size() == 0 || data.claimedDailyDays[0] is int)
        && data.lastDailyClaimDate is string
        && data.lastDailyClaimDate.size() <= 12
        && data.dailyMissionDate is string
        && data.dailyMissionDate.size() <= 12
        && data.weeklyMissionKey is string
        && data.weeklyMissionKey.size() <= 12
        && data.missionProgress is map
        && data.missionProgress.size() <= 40
        && data.claimedMissions is list
        && data.claimedMissions.size() <= 40
        && (data.claimedMissions.size() == 0 || data.claimedMissions[0] is string)
        && data.holidayClaimedIds is list
        && data.holidayClaimedIds.size() <= 40
        && (data.holidayClaimedIds.size() == 0 || data.holidayClaimedIds[0] is string)
        && data.casesOpenedTotal is int
        && data.casesOpenedTotal >= 0
        && data.casesOpenedTotal <= 1000000
        && data.mythicsFoundTotal is int
        && data.mythicsFoundTotal >= 0
        && data.mythicsFoundTotal <= 100000
        && data.skinsSoldTotal is int
        && data.skinsSoldTotal >= 0
        && data.skinsSoldTotal <= 1000000
        && data.tradesCompletedTotal is int
        && data.tradesCompletedTotal >= 0
        && data.tradesCompletedTotal <= 100000
        && data.unlockedEconomyAchievements is list
        && data.unlockedEconomyAchievements.size() <= 30
        && (data.unlockedEconomyAchievements.size() == 0 || data.unlockedEconomyAchievements[0] is string)
        && data.transactions is list
        && data.transactions.size() <= 40
        && (data.transactions.size() == 0 || data.transactions[0] is map)
        && data.processedTxIds is list
        && data.processedTxIds.size() <= 120
        && (data.processedTxIds.size() == 0 || data.processedTxIds[0] is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLeaderboardEntry(data, userId) {
      return data.keys().hasAll([
          'uid',
          'isPublic',
          'nickname',
          'equippedSkin',
          'seasonLevel',
          'seasonMonthKey',
          'totalCoins',
          'skinsCount',
          'bossesDefeatedCount',
          'achievementsCount',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'isPublic',
          'nickname',
          'equippedSkin',
          'seasonLevel',
          'playerLevel',
          'seasonMonthKey',
          'totalCoins',
          'skinsCount',
          'bossesDefeatedCount',
          'achievementsCount',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.isPublic is bool
        && data.isPublic == true
        && data.nickname is string
        && data.nickname.size() >= 1
        && data.nickname.size() <= 24
        && isValidSkinId(data.equippedSkin)
        && data.seasonLevel is int
        && data.seasonLevel >= 1
        && data.seasonLevel <= 50
        && (!('playerLevel' in data) || (data.playerLevel is int && data.playerLevel >= 1 && data.playerLevel <= 100))
        && isValidMonthKey(data.seasonMonthKey)
        && data.totalCoins is int
        && data.totalCoins >= 0
        && data.totalCoins <= 50000000
        && data.skinsCount is int
        && data.skinsCount >= 0
        && data.skinsCount <= 200
        && data.bossesDefeatedCount is int
        && data.bossesDefeatedCount >= 0
        && data.bossesDefeatedCount <= 10
        && data.achievementsCount is int
        && data.achievementsCount >= 0
        && data.achievementsCount <= 60
        && data.updatedAt is timestamp;
    }

    function isValidTradeStatus(s) {
      return s is string && (s == 'pending' || s == 'accepted' || s == 'rejected' || s == 'cancelled' || s == 'completed');
    }

    function isValidTradeOffer(data, tradeId) {
      return data.keys().hasAll([
          'tradeId',
          'senderUid',
          'senderNickname',
          'recipientUid',
          'recipientNickname',
          'offeredSkinId',
          'requestedSkinId',
          'senderConfirmed',
          'recipientConfirmed',
          'senderSettled',
          'recipientSettled',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'tradeId',
          'senderUid',
          'senderNickname',
          'recipientUid',
          'recipientNickname',
          'offeredSkinId',
          'requestedSkinId',
          'senderConfirmed',
          'recipientConfirmed',
          'senderSettled',
          'recipientSettled',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.tradeId)
        && data.tradeId == tradeId
        && isValidId(data.senderUid)
        && data.senderNickname is string
        && data.senderNickname.size() >= 1
        && data.senderNickname.size() <= 24
        && isValidId(data.recipientUid)
        && data.recipientNickname is string
        && data.recipientNickname.size() >= 1
        && data.recipientNickname.size() <= 24
        && isValidSkinId(data.offeredSkinId)
        && isValidSkinId(data.requestedSkinId)
        && data.senderConfirmed is bool
        && data.recipientConfirmed is bool
        && data.senderSettled is bool
        && data.recipientSettled is bool
        && isValidTradeStatus(data.status)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().lastLoginAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().lastLoginAt == request.time
        && (!incoming().diff(existing()).affectedKeys().hasAny(['lastVerifiedAt']) || incoming().lastVerifiedAt == request.time)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'photoURL',
          'nickname',
          'spiderColor',
          'profileCompleted',
          'lastVerifiedAt',
          'lastLoginAt'
        ]);
      allow delete: if false;
    }

    match /userSaves/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserSave(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserSave(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'hasStarted',
          'currentStageId',
          'unlockedStageIds',
          'unlockedAbilities',
          'activeSpecial',
          'totalCoins',
          'totalScore',
          'lives',
          'stageProgress',
          'unlockedAchievements',
          'bossesDefeated',
          'enemiesDefeatedTotal',
          'secretsFoundTotal',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /userEconomy/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserEconomy(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserEconomy(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'spikeyCoins',
          'equippedSkin',
          'ownedSkins',
          'equippedWebDesign',
          'ownedWebDesigns',
          'playerXp',
          'playerLevel',
          'selectedLanguage',
          'ownedCases',
          'specialItems',
          'seasonMonthKey',
          'seasonXp',
          'claimedSeasonLevels',
          'dailyStreak',
          'claimedDailyDays',
          'lastDailyClaimDate',
          'dailyMissionDate',
          'weeklyMissionKey',
          'missionProgress',
          'claimedMissions',
          'holidayClaimedIds',
          'casesOpenedTotal',
          'mythicsFoundTotal',
          'skinsSoldTotal',
          'tradesCompletedTotal',
          'unlockedEconomyAchievements',
          'transactions',
          'processedTxIds',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /leaderboard/{userId} {
      allow get: if isValidId(userId) && (
        isOwner(userId) || (isVerifiedUser() && resource != null && existing().isPublic == true)
      );
      allow list: if isVerifiedUser() && existing().isPublic == true;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidLeaderboardEntry(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidLeaderboardEntry(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().isPublic == existing().isPublic
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'nickname',
          'equippedSkin',
          'seasonLevel',
          'playerLevel',
          'seasonMonthKey',
          'totalCoins',
          'skinsCount',
          'bossesDefeatedCount',
          'achievementsCount',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /trades/{tradeId} {
      allow get: if isValidId(tradeId) && isVerifiedUser()
        && resource != null
        && (existing().senderUid == request.auth.uid || existing().recipientUid == request.auth.uid);
      allow list: if isVerifiedUser()
        && (existing().senderUid == request.auth.uid || existing().recipientUid == request.auth.uid);
      allow create: if isValidId(tradeId)
        && isVerifiedUser()
        && isValidTradeOffer(incoming(), tradeId)
        && incoming().senderUid == request.auth.uid
        && incoming().recipientUid != request.auth.uid
        && incoming().status == 'pending'
        && incoming().senderConfirmed == true
        && incoming().recipientConfirmed == false
        && incoming().senderSettled == false
        && incoming().recipientSettled == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/leaderboard/$(incoming().recipientUid));
      allow update: if isValidId(tradeId)
        && isVerifiedUser()
        && isValidTradeOffer(incoming(), tradeId)
        && incoming().tradeId == existing().tradeId
        && incoming().senderUid == existing().senderUid
        && incoming().recipientUid == existing().recipientUid
        && incoming().offeredSkinId == existing().offeredSkinId
        && incoming().requestedSkinId == existing().requestedSkinId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (existing().status == 'pending' || existing().status == 'accepted')
        && (
          (existing().status == 'pending'
            && request.auth.uid == existing().senderUid
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
          ||
          (existing().status == 'pending'
            && request.auth.uid == existing().recipientUid
            && incoming().status == 'rejected'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
          ||
          (existing().status == 'pending'
            && request.auth.uid == existing().recipientUid
            && incoming().status == 'accepted'
            && incoming().recipientConfirmed == true
            && incoming().recipientSettled == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'recipientConfirmed', 'recipientSettled', 'updatedAt']))
          ||
          (existing().status == 'accepted'
            && existing().senderSettled == false
            && request.auth.uid == existing().senderUid
            && incoming().status == 'completed'
            && incoming().senderSettled == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'senderSettled', 'updatedAt']))
        );
      allow delete: if false;
    }
  }
}
